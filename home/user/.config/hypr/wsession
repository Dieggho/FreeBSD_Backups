#!/bin/sh

pkill fuzzel 2>/dev/null

entries=" Logout
 Reboot
 Shutdown"

selected=$(printf '%s\n' "$entries" | fuzzel --lines 3 --dmenu --width 13 --anchor top-right --prompt "Session > " | awk '{print tolower($2)}')

case "$selected" in
  logout)
   Kill ; wlrctl window close ; sleep 1 ; wayland-logout #hyprctl dispatch exit
    ;;
  reboot)
    Kill ; wlrctl window close ; sleep 1 ; mdo reboot 
    ;;
   shutdown)
    Kill ; wlrctl window close ; sleep 1 ; mdo poweroff 
    ;;
esac
