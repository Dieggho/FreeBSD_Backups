#!/usr/bin/env dash

pkill fuzzel 2>/dev/null

entries="  Smart-terminal
  Deadbeef
  Telegram
  Browser
  Calculator
  Editor
  Gucharmap
  Gtk-Theme
  Gimp
  Waypaper
  Terminal
  File"


selected=$(printf '%s\n' "$entries" | fuzzel --dmenu --lines 12 --width 20 --anchor top-left --prompt "Applications > " | awk '{print tolower($2)}')

case "$selected" in
  file)
    pcmanfm
    ;;
  deadbeef)
    deadbeef
    ;;
  telegram)
    Telegram
    ;;
  browser)
    firefox 
    ;;
  calculator)
    galculator
    ;;
  editor)
    lite-xl
    ;;
  gucharmap)
    gucharmap
    ;;
  gtk-theme)
    nwg-look
    ;;
  gimp)
    gimp-2.10
    ;;
  waypaper)
    waypaper
    ;;
  terminal)
    foot
    ;;
  smart-terminal)
    foot -a SmartTerm
    ;;
esac
