#!/usr/bin/env dash

pkill fuzzel 2>/dev/null

entries="  Smart-terminal
  Music
  Telegram
  Browser
  Transmission
  Calculator
  Editor
  Gucharmap
  Gtk-Theme
  Gimp
  Waypaper
  Terminal
  File"


selected=$(printf '%s\n' "$entries" | fuzzel --dmenu --lines 13 --width 20 --anchor top-left --prompt "Applications > " | awk '{print tolower($2)}')

case "$selected" in
  file)
    pcmanfm &
    ;;
  music)
    pragha &
    ;;
  telegram)
    Telegram &
    ;;
  browser)
    firefox &
    ;;
  transmission)
    transmission-gtk &
    ;;
  calculator)
    galculator &
    ;;
  editor)
    lite-xl &
    ;;
  gucharmap)
    gucharmap &
    ;;
  gtk-theme)
    nwg-look &
    ;;
  gimp)
    gimp &
    ;;
  waypaper)
    waypaper &
    ;;
  terminal)
    foot &
    ;;
  smart-terminal)
    foot -a SmartTerm &
    ;;
esac
