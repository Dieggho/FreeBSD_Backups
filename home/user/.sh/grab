#!/usr/bin/env dash

on() {
cat << EOF > /home/void/.sh/grabstatus
#!/usr/bin/env dash
echo 
EOF
hyprctl keyword bindm ,mouse:272,movewindow
echo ok
}

off() {
cat << EOF > /home/void/.sh/grabstatus
#!/usr/bin/env dash
echo 
EOF
hyprctl keyword unbind ,mouse:272,movewindow
echo ok
}

case "$@" in
  bindm)
	on;;
  unbind)
	off;;
esac
