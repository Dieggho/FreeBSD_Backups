HISTFILE=
HISTSIZE=9999

# =====================================================
# ALIASES 
# =====================================================

alias BSD='clear; fastfetch; gpart show nda0;'
alias Exit='clear ; exit'
alias exrc='vi ~/.shrc'
alias bsd='clear; ufetch; gpart show nda0; '
alias clvitmp='rm -fv /tmp/vi*'
alias du-='mdo du -hs ~ ; mdo du -hs /usr/local'
alias exrc='vi ~/.exrc'
alias halt='mdo halt'
alias la='ls -la'
alias lsblk='gpart show'
alias lsvm='ls /dev/vmm/'
alias lswifi='pciconf -lv | grep -B2 -A1 -i Wireless'
alias myip='curl ident.me; echo'
alias pick=hyprpicker
alias pkg-resync='mdo pkg-static upgrade -f'
alias pkgadd='mdo pkg install '
alias pkgls='pkg prime-list'
alias pkgs='mdo pkg search '
alias poweroff='mdo poweroff'
alias reboot='mdo reboot'
alias scanwifi='mdo wpa_cli scan; sleep 1; mdo wpa_cli scan_results'
alias shrc='vi ~/.shrc'
alias su-='mdo env HOME=/root ENV=/root/.shrc /bin/sh'
alias viboot='mdo vi /boot/loader.conf'
alias vibsd='mdo vi /etc/rc.conf ; mdo vi /etc/sysctl.conf ; mdo vi /boot/loader.conf'
alias vihypr='vi /home/void/.config/hypr/hyprland.lua'
alias virc='mdo vi /etc/rc.conf'
alias visysctl='mdo vi /etc/sysctl.conf'
alias viwifi='mdo vi /usr/local/etc/wifibox/wpa_supplicant/wpa_supplicant.conf'
alias wifidown='mdo service netif stop wifibox0'
alias wifireload='mdo service netif restart wifibox0'
alias wifiup='mdo service netif start wifibox0'
alias zzz='mdo zzz'

# =====================================================
# FUNCTIONS
# =====================================================

vmkill() {
   mdo bhyvectl --destroy --vm=$1
}

pkgq() {
echo "packages installed: [ $(pkg query '%n' | wc -l | tr -d ' ') ]"
}

pkgup() {
    mdo pkg upgrade
    #uname -r
    #echo
    #bectl list
    pkgq
}

pkgrm() {
    mdo pkg remove $@
    mdo pkg autoremove
    mdo pkg clean -a
    pkgq
}

pkgclr() {
    mdo pkg autoremove
    mdo pkg clean -a
    pkgq
}


