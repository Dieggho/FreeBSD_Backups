HISTFILE=
HISTSIZE=9999

# =====================================================
# ALIASES 
# =====================================================
alias zzz='doas zzz'
alias reboot='doas reboot'
alias Exit='clear ; exit'
alias poweroff='doas poweroff'
alias du-='doas du -hs ~ ; doas du -hs /usr/local'
alias myip='curl ident.me; echo'
alias bsd='clear; ufetch; gpart show nda0; '
alias BSD='clear; neofetch; gpart show nda0;'
alias shrc='vi ~/.shrc'
alias exrc='vi ~/.exrc'
alias doas-i='doas su -'
alias clvitmp='rm -fv /tmp/vi*'
alias la='ls -la'
alias pick='hyprpicker'
alias pkgs='doas pkg search '
alias pkgls='pkg prime-list '
alias pkgup='doas pkg upgrade '
alias pkgi='doas pkg install '
alias pkgrm='doas pkg remove $@'
alias pkg-resync='doas pkg-static upgrade -f'
alias bsdup='doas freebsd-update fetch; doas freebsd-update install '
alias bsdclr='doas rm -rf /boot/kernel.old /boot/modules.old'
alias wifiup='doas service netif start wifibox0'
alias wifidown='doas service netif stop wifibox0'
alias scanwifi='doas wpa_cli scan; sleep 1; doas wpa_cli scan_results'
alias wifireload='doas service netif restart wifibox0'
alias viboot='doas vi /boot/loader.conf' 
alias virc='doas vi /etc/rc.conf'
alias visysctl='doas vi /etc/sysctl.conf'
alias vibsd='doas vi /etc/rc.conf ; doas vi /etc/sysctl.conf ; doas vi /boot/loader.conf'
alias viwifi='doas vi /usr/local/etc/wifibox/wpa_supplicant/wpa_supplicant.conf'
alias lswifi='pciconf -lv | grep -B2 -A1 -i Wireless'

# =====================================================
# FUNCTIONS
# =====================================================

rename(){
for file in *; do
  if [ -f "$file" ]; then
    # Extrai a extensão de forma segura
    ext=$(echo "$file" | awk -F. '{if (NF>1) print $NF}')
    
    # Gera o novo nome único
    novo_nome=$(uuidgen)
    
    # Renomeia aplicando a extensão se ela existir
    if [ -z "$ext" ]; then
      mv "$file" "$novo_nome"
    else
      mv "$file" "${novo_nome}.${ext}"
    fi
  fi
done
}

pkgclr() {
    doas pkg autoremove
    doas pkg clean -a
    echo "packages installed: [ $(pkg query '%n' | wc -l | tr -d ' ') ]"
}

pkgq() {
echo "packages installed: [ $(pkg query '%n' | wc -l | tr -d ' ') ]"
}

fbsdup(){
    echo "pkg update..."
    doas pkg upgrade
    echo
    echo "freebsd update..."
    doas freebsd-update fetch
    doas freebsd-update install
    echo
    if [ -f /var/run/reboot-required ]; then
    echo "reboot required"
    fi
    bectl list
    echo
    uname -r
    echo "packages installed: [ $(pkg query '%n' | wc -l | tr -d ' ') ]"    
}

bsd-relup() {
    set -e

    target="${1:?usage: relup <release-version>}"

    be="relup-${target}-$(date +%Y%m%d-%H%M)"

    echo "[ creating boot environment ]"
    doas bectl create "$be"
    doas bectl activate "$be"

    echo
    echo "[ fetching FreeBSD ${target} ]"
    doas freebsd-update upgrade -r "$target"

    echo
    echo "[ installing upgrade stage 1 ]"
    doas freebsd-update install

    echo
    echo "[ release upgrade prepared ]"
    echo "reboot required to continue upgrade"

    echo
    echo "active boot environment: $be"
}

bsd-relup-finish() {
    set -e

    echo "[ continuing freebsd-update ]"
    doas freebsd-update install

    echo
    echo "[ resyncing packages ]"
    doas pkg-static upgrade -f

    echo
    echo "[ finalizing upgrade ]"
    doas freebsd-update install || true

    echo
    echo "[ system status ]"
    uname -a

    echo
    echo "packages installed: [ $(pkg query '%n' | wc -l | tr -d ' ') ]"
}

beroll() {
    doas bectl activate "$1"
    echo "boot environment '$1' activated"
    echo "reboot required"
}

be-pkgup() {
    be="pkgup-$(date +%Y%m%d-%H%M)"
    doas bectl create "$be"
    doas bectl activate "$be"
    doas pkg upgrade
}

